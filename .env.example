# ---- Local development (docker-compose) ----
DATABASE_URL=postgresql://attendance:attendance@localhost:5432/attendance
DATABASE_URL_DIRECT=
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# ---- Deployed (Vercel + Supabase) ----
# DATABASE_URL should be Supabase's Supavisor connection string in TRANSACTION
# mode (port 6543) - used by the app at request time.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Note: Supabase's dashboard sometimes appends "?pgbouncer=true" to this URI for
# drivers (asyncpg/Prisma) that manage server-side prepared statements - strip
# it for psycopg2/SQLAlchemy, which doesn't recognize it as a libpq option and
# will fail to connect with "invalid connection option pgbouncer".
#
# DATABASE_URL_DIRECT should be Supabase's direct/session-mode connection string
# (port 5432) - used only for running `alembic upgrade head`.
# DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
#
# ENVIRONMENT=production
# CORS_ORIGINS=https://your-app.vercel.app

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---- App ----
APP_TIMEZONE=Asia/Kolkata

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000

# ---- Tests (set these as real env vars when running pytest, not read from
# this file - see README "Running Tests") ----
# Point DATABASE_URL at a disposable database (e.g. local `attendance_test`)
# and leave TEST_DB_SCHEMA unset - the whole `public` schema is created/dropped
# per run.
#
# Point DATABASE_URL at a real project database (e.g. Supabase, direct
# connection, port 5432) instead and set TEST_DB_SCHEMA - tests then run
# inside that schema only and DROP just that schema at teardown, leaving
# `public` (real app/seed data) untouched.
# TEST_DB_SCHEMA=pytest_attendance
